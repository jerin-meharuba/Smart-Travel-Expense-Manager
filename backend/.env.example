# Local development uses SQLite when DATABASE_URL is not set.
DATABASE_URL=sqlite:///./smart_travel_expense.db
FRONTEND_ORIGIN=http://localhost:5173
SECRET_KEY=replace-with-a-strong-random-secret

# Production values belong only in Vercel's environment-variable settings.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# FRONTEND_ORIGIN=https://your-project.vercel.app
# SECRET_KEY=generate-a-long-random-secret-and-never-commit-it
